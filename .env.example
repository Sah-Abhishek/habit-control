# Copy to .env.local for development. Never commit real secrets.
# PostgreSQL connection string. `pnpm db:start` runs a local cluster on 54329.
DATABASE_URL=postgres://postgres@localhost:54329/almanac
# 32+ random bytes, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=replace-me
# Public origin of the app (used for auth callbacks and CSRF origin checks)
BETTER_AUTH_URL=http://localhost:3000
